# Cau hinh rieng cua logger XIAO ESP32S3 (Brief 08). Khong lien quan sdkconfig.esp32s3 cua devkit.
# Console = USB Serial/JTAG (cong USB-C cua XIAO). Du lieu di qua driver usb_serial_jtag (doc/ghi truc tiep).
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Chi in cac dong cua giao thuc logger: tat log ESP-IDF va log bootloader
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# Tick 1 kHz (vTaskDelay chinh xac 1 ms khi can); toi uu toc do (logger khong phai thu duoc do)
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Task doc INA226 chay 'bao hoa' trong I2C nen khong de idle task loi 1 doi hoi watchdog
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Flash 8 MB cua XIAO ESP32S3 (khop board_upload.flash_size; mac dinh IDF la 2 MB gay canh bao mismatch)
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
